DELIMITER //
CREATE OR REPLACE FUNCTION limitKredytowy(wartosc DOUBLE)
RETURNS VARCHAR(30)
DETERMINISTIC
BEGIN
    CASE
       WHEN wartosc < 100000 THEN RETURN 'mały';
       WHEN wartosc >= 100000 AND wartosc < 200000 THEN RETURN 'średni';
       ELSE RETURN 'duży';
    END CASE;
END //
DELIMITER ;

