CREATE OR REPLACE FUNCTION limitKredytowy(wartosc DOUBLE)
RETURNS VARCHAR(30)
DETERMINISTIC 
RETURN (
     SELECT CASE
         WHEN wartosc < 100000 THEN 'mały'
         WHEN wartosc >= 100000 AND wartosc < 200000 THEN 'średni'
         ELSE 'duży'
     END
)

