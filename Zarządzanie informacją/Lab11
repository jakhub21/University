DELIMITER //
CREATE OR REPLACE FUNCTION limitKredytowy(wartosc DOUBLE)
RETURNS VARCHAR(30)
DETERMINISTIC
BEGIN
    DECLARE okreslenie VARCHAR(20);
    CASE
       WHEN wartosc < 100000 THEN SET okreslenie = 'mały';
       WHEN wartosc >= 100000 AND wartosc < 200000 THEN SET okreslenie = 'średni';
       ELSE SET okreslenie = 'duży';
    END CASE;
    RETURN okreslenie;
END //
DELIMITER ;

