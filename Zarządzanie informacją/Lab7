zad10

SELECT TRUNCATE ( SUM( quantityInStock * buyPrice ),0) AS SUM
FROM `products`

zad10a
SELECT TRUNCATE (SUM( quantityInStock * buyPrice ),0) AS SUM, SUM( ROUND( `quantityInStock` ) * ROUND( `buyPrice` ) ) AS SUM_ROUND
FROM `products`


zad10B
SELECT TRUNCATE ( SUM( quantityInStock * buyPrice ),0) AS SUM, SUM( ROUND( `quantityInStock` ) * ROUND( `buyPrice` ) ) AS SUM_ROUND, SUM( CEIL( `quantityInStock` ) * CEIL( `buyPrice` ) ) AS SUM_CEIL
FROM `products`

ZAD10C
SELECT TRUNCATE ( SUM( quantityInStock * buyPrice ),0) AS SUM, SUM( ROUND( `quantityInStock` ) * ROUND( `buyPrice` ) ) AS SUM_ROUND, SUM( CEIL( `quantityInStock` ) * CEIL( `buyPrice` ) ) AS SUM_CEIL, SUM( FLOOR( `quantityInStock` ) * FLOOR( `buyPrice` ) ) AS SUM_FLOOR
FROM `products`

CEIL- zaokragla w gore
FLOOR- zaokragla w dol
ROUND-zaokraglanie do najblizszej liczby lub po podaniu po przecinku, do danej liczby miejsc po przecinku


