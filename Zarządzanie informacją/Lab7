ZAD 1

SELECT `customerNumber`,`postalCode`,
CONVERT(`postalCode`,DATE) AS
postalCodeDate
FROM `customers` 
WHERE `postalCode` IS NOT NULL
ORDER BY postalCodeDate

ZAD2

SELECT `customerNumber`,`postalCode`,CAST(`postalCode` AS TIME) AS postalCodeTime
FROM `customers` 
WHERE `postalCode` IS NOT NULL
ORDER BY postalCodeTime


