zad2
a)
SELECT CONCAT( DATE_FORMAT( orderDate, '%Y, ' ) , 
UPPER( DATE_FORMAT( orderDate, '%M ' ) ) , DATE_FORMAT( orderDate, '%D' ) , '-- ', 
UPPER( DATE_FORMAT( orderDate, '%W' ) ) ) AS 'Data'
FROM orders

b)
